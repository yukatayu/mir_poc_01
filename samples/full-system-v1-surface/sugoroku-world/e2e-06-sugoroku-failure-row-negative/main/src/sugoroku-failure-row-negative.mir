module Surface.E2E.SugorokuFailureRowNegative

role BrowserClient
place World

record Player {
  position: Int64,
}

World {
  state player[p: Participant]: Player
    visible observer_safe fields { position }
}

BrowserClient[self] {
  when roll(draw: Int64) {
    World {
      player[self].position = player[self].position + draw
    }
  }
}
