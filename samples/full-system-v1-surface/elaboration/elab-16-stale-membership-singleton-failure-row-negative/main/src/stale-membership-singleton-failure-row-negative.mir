module Surface.Elab.StaleMembershipSingletonFailureRowNegative

role BrowserClient
place S

record Player {
  hp: Int64,
}

S {
  state player[p: Participant]: Player
}

BrowserClient[self] {
  when attack(target: Participant) fails MissingCapability, MissingWitness, RouteUnavailable {
    S {
      player[target].hp = 1
    }
  }
}
