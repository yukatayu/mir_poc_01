{
  "schema_version": "mirrorea-product-alpha1-v0",
  "package_id": "operational-world-core-starter",
  "package_version": "0.1.0-alpha.1",
  "package_kind": "world_core",
  "dependencies": [],
  "effects": [
    "AdmitParticipant",
    "LeaveParticipant",
    "ObserveWorld"
  ],
  "failures": [
    "MissingCapability",
    "StaleMembership",
    "MissingWitness"
  ],
  "capabilities": [
    "WorldAdmin",
    "JoinWorld",
    "ObserveWorld"
  ],
  "witness_requirements": [],
  "membership_requirements": [
    "active_admin_participant",
    "active_participant"
  ],
  "auth_policy": {
    "policy_id": "operational-world-core-starter-auth-policy",
    "required_bindings": [
      "participant_membership",
      "admin_membership"
    ]
  },
  "auth_stack": [
    "membership_auth",
    "capability_auth"
  ],
  "contracts": [
    {
      "contract_id": "operational-world-core-starter-contract",
      "variance": "invariant",
      "effect_row": [
        "AdmitParticipant",
        "LeaveParticipant"
      ],
      "failure_row": [
        "MissingCapability",
        "StaleMembership"
      ]
    }
  ],
  "observation_policy": {
    "view_role": "observer_safe",
    "labels": [
      "observer_safe_world_starter_summary"
    ]
  },
  "redaction_policy": {
    "level": "observer_safe",
    "redacted_fields": [
      "raw_witness_payload",
      "raw_auth_evidence"
    ]
  },
  "retention_policy": {
    "scope": "operational_world_starter_session",
    "retained_artifacts": [
      "checker_report",
      "runtime_plan",
      "event_dag_summary"
    ]
  },
  "message_recovery_policy": {
    "handled_failures": [
      "timeout",
      "reject"
    ],
    "recovery": "retry_then_reject"
  },
  "savepoint_policy": {
    "classes": [
      "R0",
      "R2"
    ],
    "quiescent_required": true
  },
  "native_policy": {
    "execution_policy": "disabled",
    "provenance_required": true
  },
  "compatibility": {
    "min_cli_schema_version": "mirrorea-product-alpha1-v0",
    "migration_policy": "alpha_schema_migration_required"
  }
}
