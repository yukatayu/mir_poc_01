{
  "schema_version": "mirrorea-product-alpha1-v0",
  "package_id": "operational-sugoroku",
  "package_version": "0.1.0-alpha.1",
  "package_kind": "sugoroku_world",
  "dependencies": [
    "../membership-chat"
  ],
  "effects": [
    "RollDice",
    "PublishRoll",
    "HandoffTurn",
    "ResetGame",
    "typed_host_io.add_one"
  ],
  "failures": [
    "StaleMembership",
    "MissingCapability",
    "MissingWitness",
    "NotDiceOwner",
    "RateLimited",
    "AdapterUnavailable"
  ],
  "capabilities": [
    "RollDice",
    "PublishRoll",
    "HandoffTurn",
    "ResetGame",
    "ObserveDebugSummary"
  ],
  "witness_requirements": [
    "draw_pub"
  ],
  "membership_requirements": [
    "active_admin_participant",
    "active_participant"
  ],
  "auth_policy": {
    "policy_id": "operational-sugoroku-auth-policy",
    "required_bindings": [
      "participant_membership",
      "admin_membership"
    ]
  },
  "auth_stack": [
    "membership_auth",
    "capability_auth"
  ],
  "contracts": [
    {
      "contract_id": "operational-sugoroku-roll-contract",
      "variance": "invariant",
      "effect_row": [
        "RollDice",
        "PublishRoll"
      ],
      "failure_row": [
        "MissingCapability",
        "NotDiceOwner"
      ]
    },
    {
      "contract_id": "operational-sugoroku-handoff-contract",
      "variance": "invariant",
      "effect_row": [
        "HandoffTurn"
      ],
      "failure_row": [
        "MissingWitness",
        "StaleMembership"
      ]
    }
  ],
  "observation_policy": {
    "view_role": "observer_safe",
    "labels": [
      "observer_safe_sugoroku_summary"
    ]
  },
  "redaction_policy": {
    "level": "observer_safe",
    "redacted_fields": [
      "raw_witness_payload",
      "raw_auth_evidence"
    ]
  },
  "retention_policy": {
    "scope": "operational_sugoroku_session",
    "retained_artifacts": [
      "checker_report",
      "runtime_plan",
      "observer_safe_event_ids",
      "observer_safe_route_ids"
    ]
  },
  "message_recovery_policy": {
    "handled_failures": [
      "timeout",
      "reject"
    ],
    "recovery": "retry_then_reject"
  },
  "savepoint_policy": {
    "classes": [
      "R0",
      "R2"
    ],
    "quiescent_required": true
  },
  "runtime_input": {
    "entry_place": "Place[SugorokuGamePlace]",
    "host_io": {
      "adapter_kind": "AddOne",
      "effect_ref": "typed_host_io.add_one",
      "request_payload": {
        "kind": "int",
        "value": 41
      },
      "expected_response": {
        "kind": "int",
        "value": 42
      }
    }
  },
  "native_policy": {
    "execution_policy": "disabled",
    "provenance_required": true
  },
  "compatibility": {
    "min_cli_schema_version": "mirrorea-product-alpha1-v0",
    "migration_policy": "alpha_schema_migration_required"
  }
}
