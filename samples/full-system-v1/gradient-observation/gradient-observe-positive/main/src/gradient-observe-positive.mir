module FullSystemV1.GradientObservationPositive

import Shared.WorldCoreBase
import Shared.MembershipChatBase
import Shared.SugorokuBase
import Shared.PortalWorldLinkBase
import Shared.ShardBoundaryBase
import Shared.GradientObservationBase

capability Publisher
capability Observer
capability ObserveGradientBoundary
capability ProjectGradientView

effect publish_membership_epoch(epoch: Int64) {
  requires Publisher
  failure PublishRejected
}

effect observe_membership_epoch {
  requires Observer
  output epoch: Int64
  failure ObserveRejected
}

effect publish_gradient_view(zone: Text) {
  requires Publisher, ObserveGradientBoundary
  failure PublishRejected
}

effect observe_gradient_view {
  requires Observer
  output zone: Text
  failure ObserveRejected
}

effect publish_gradient_handoff_hint(hint: Text) {
  requires Publisher, ProjectGradientView
  failure PublishRejected
}

effect export_gradient_summary(summary: Text) {
  failure ExportRejected
}

transition gradient_turn at GradientObservationBoundaryPlace requires Publisher, Observer, ObserveGradientBoundary, ProjectGradientView {
  let epoch: Int64 = 2
  perform publish_membership_epoch(epoch) via publish_bus
  seen_epoch <- perform observe_membership_epoch via observe_bus
    require membership_active(seen_epoch)
  zone <- gradient_zone(0)
  perform publish_gradient_view(zone) via publish_bus
  seen_zone <- perform observe_gradient_view via observe_bus
    ensure seen_zone = zone
  hint <- gradient_hint(0)
  perform publish_gradient_handoff_hint(hint) via publish_bus
  summary <- gradient_observer_note(0)
  perform export_gradient_summary(summary) via diagnostic_export
}
