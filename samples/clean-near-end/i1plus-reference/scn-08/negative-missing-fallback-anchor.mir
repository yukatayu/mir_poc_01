module M10.Scn08.NegativeMissingFallbackAnchor

locus World
locus Viewer
principal self
type Player

state live_pose[id: Player] at World {
  x: Int
  y: Int
  visible observer_safe fields (x, y)
}

state room_anchor[id: Player] at World {
  x: Int
  y: Int
}

relation view_pose at World {
  subject self: Player
  primary live_pose epoch avatar_session transform translate(0, 0)
  fallback room_anchor epoch room_epoch transform identity
  bind frontier pose_binding_frontier
  publish relation
  project at Viewer local
}

with auth MembershipAuth
verify finite_refinement
