module M10.Scn09.Base

locus World
locus BrowserClient
principal self
type Player

state player[id: Player] at World {
  hp: Int
  visible observer_safe fields (hp)
}

Role[self] at BrowserClient {
  when touch(delta: Int) fails (MissingCapability, MissingWitness, RouteUnavailable, StaleMembership, VisibilityDenied) {
    at World {
      player[self].hp = player[self].hp + delta
    }
  }
}

with auth MembershipAuth
verify finite_refinement
