module M10.Scn04.Positive

locus World
locus BrowserClient
principal self
principal target
type Player

state player[id: Player] at World {
  hp: Int
  tombstone: Int
}

Role[self] at BrowserClient {
  when inspect(target: Player) fails (StaleMembership, MissingCapability, MissingWitness, RouteUnavailable) {
    at World {
      player[target].tombstone = player[target].tombstone + 1
    }
  }
}

with auth MembershipAuth
verify finite_refinement
