(set-option :timeout 10000)
(set-option :produce-proofs true)
(declare-const s (Array Int (Array Int Int)))
(declare-const l Int)
(declare-const m Int)
(declare-const x Int)
(declare-const v Int)
(assert (distinct l m))
(assert (not (= (select (store s l (store (select s l) x v)) m) (select s m))))
(check-sat-using (then (using-params simplify :som true) smt))
(get-proof)
