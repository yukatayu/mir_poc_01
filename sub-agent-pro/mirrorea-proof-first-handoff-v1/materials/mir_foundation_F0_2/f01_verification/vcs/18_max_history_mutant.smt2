(set-option :timeout 10000)
(set-option :produce-proofs true)
(declare-const old Int)
(declare-const new Int)
(declare-const histmax Int)
(assert (= old 1))
(assert (= new 0))
(assert (= histmax 1))
(assert (<= old histmax))
(assert (<= new histmax))
(assert (not (<= old new)))
(check-sat-using (then (using-params simplify :som true) smt))
(get-model)
