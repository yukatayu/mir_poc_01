(set-option :timeout 10000)
(set-option :produce-proofs true)
(declare-const s (Array Int Int))
(declare-const cfg Int)
(declare-const other Int)
(declare-const v Int)
(assert (distinct cfg other))
(assert (>= (select s cfg) 0))
(assert (not (>= (select (store s other v) cfg) 0)))
(check-sat-using (then (using-params simplify :som true) smt))
(get-proof)
