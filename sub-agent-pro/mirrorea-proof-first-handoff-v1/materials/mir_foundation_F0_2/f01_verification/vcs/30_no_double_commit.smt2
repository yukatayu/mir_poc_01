(set-option :timeout 10000)
(set-option :produce-proofs true)
(declare-const count Int)
(declare-const seen Bool)
(declare-const grant Bool)
(declare-const eligible Bool)
(assert (= seen (= count 1)))
(assert (<= 0 count))
(assert (<= count 1))
(assert (not (let ((fire (and (not seen) grant eligible))) (and (<= (+ count (ite fire 1 0)) 1) (= (or seen fire) (= (+ count (ite fire 1 0)) 1))))))
(check-sat-using (then (using-params simplify :som true) smt))
(get-proof)
