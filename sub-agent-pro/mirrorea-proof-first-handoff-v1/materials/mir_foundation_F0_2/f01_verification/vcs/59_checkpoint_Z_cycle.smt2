(set-option :timeout 10000)
(set-option :produce-proofs true)
(declare-const a Int)
(declare-const b Int)
(assert (= a 1))
(assert (<= 0 b))
(assert (<= b 1))
(assert (=> (>= a 1) (>= b 1)))
(assert (=> (>= b 1) (>= a 2)))
(assert (not false))
(check-sat-using (then (using-params simplify :som true) smt))
(get-proof)
