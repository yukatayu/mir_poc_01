(set-option :timeout 10000)
(set-option :produce-proofs true)
(declare-const base Int)
(declare-const n Int)
(declare-const k Int)
(assert (> n 0))
(assert (> k 0))
(assert (< k n))
(assert (not (and (> (- n k) 0) (= (+ k (- n k)) n) (= (+ (+ base k) (- n k)) (+ base n)))))
(check-sat-using (then (using-params simplify :som true) smt))
(get-proof)
