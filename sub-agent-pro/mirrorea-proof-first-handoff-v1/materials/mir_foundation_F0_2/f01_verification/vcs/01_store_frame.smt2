(set-option :timeout 10000)
(set-option :produce-proofs true)
(declare-const s (Array Int Int))
(declare-const x Int)
(declare-const y Int)
(declare-const v Int)
(assert (distinct x y))
(assert (not (= (select (store s x v) y) (select s y))))
(check-sat-using (then (using-params simplify :som true) smt))
(get-proof)
