(set-option :timeout 10000)
(set-option :produce-proofs true)
(declare-const bs Int)
(declare-const br Int)
(declare-const ds Int)
(declare-const dr Int)
(declare-const s Int)
(declare-const r Int)
(assert (<= bs ds))
(assert (<= br dr))
(assert (>= br r))
(assert (=> (>= dr r) (>= ds s)))
(assert (not (<= (ite (> bs s) bs s) ds)))
(check-sat-using (then (using-params simplify :som true) smt))
(get-proof)
