(set-option :timeout 10000)
(set-option :produce-proofs true)
(declare-const eActual Bool)
(declare-const eNew Bool)
(declare-const eOld Bool)
(assert (=> eActual eNew))
(assert (=> eNew eOld))
(assert (not (=> eActual eOld)))
(check-sat-using (then (using-params simplify :som true) smt))
(get-proof)
