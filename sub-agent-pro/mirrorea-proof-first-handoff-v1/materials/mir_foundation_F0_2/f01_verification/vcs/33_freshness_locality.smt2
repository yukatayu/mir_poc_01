(set-option :timeout 10000)
(set-option :produce-proofs true)
(declare-const v (Array Int Int))
(declare-const x Int)
(declare-const y Int)
(declare-const newver Int)
(assert (distinct x y))
(assert (not (= (select (store v y newver) x) (select v x))))
(check-sat-using (then (using-params simplify :som true) smt))
(get-proof)
