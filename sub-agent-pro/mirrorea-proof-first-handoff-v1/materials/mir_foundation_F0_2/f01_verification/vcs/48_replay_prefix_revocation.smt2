(set-option :timeout 10000)
(set-option :produce-proofs true)
(declare-const snapshotRevoked Bool)
(declare-const currentRevoked Bool)
(assert (not snapshotRevoked))
(assert currentRevoked)
(assert (not (or snapshotRevoked currentRevoked)))
(check-sat-using (then (using-params simplify :som true) smt))
(get-proof)
