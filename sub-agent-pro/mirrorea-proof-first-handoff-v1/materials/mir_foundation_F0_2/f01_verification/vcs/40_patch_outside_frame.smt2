(set-option :timeout 10000)
(set-option :produce-proofs true)
(declare-const s (Array Int Int))
(declare-const x Int)
(declare-const y Int)
(assert (distinct x y))
(assert (not (= (select (store s x (+ (select s x) 1)) y) (select s y))))
(check-sat-using (then (using-params simplify :som true) smt))
(get-proof)
