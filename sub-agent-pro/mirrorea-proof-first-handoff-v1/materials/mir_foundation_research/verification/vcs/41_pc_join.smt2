(set-option :timeout 10000)
(set-option :produce-proofs true)
(declare-const pc Int)
(declare-const e Int)
(declare-const target Int)
(assert (<= 0 pc))
(assert (<= pc 1))
(assert (<= 0 e))
(assert (<= e 1))
(assert (= target 0))
(assert (<= (ite (> pc e) pc e) target))
(assert (not (and (= pc 0) (= e 0))))
(check-sat-using (then (using-params simplify :som true) smt))
(get-proof)
