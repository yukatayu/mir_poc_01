(set-option :timeout 10000)
(set-option :produce-proofs true)
(declare-const lp Bool)
(declare-const lc Bool)
(declare-const dp Bool)
(declare-const dc Bool)
(assert (=> lc lp))
(assert (=> dp dc))
(assert (not (=> (and lc (not dc)) (and lp (not dp)))))
(check-sat-using (then (using-params simplify :som true) smt))
(get-proof)
