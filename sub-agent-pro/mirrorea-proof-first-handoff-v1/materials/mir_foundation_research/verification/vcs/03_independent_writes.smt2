(set-option :timeout 10000)
(set-option :produce-proofs true)
(declare-const s (Array Int Int))
(declare-const x Int)
(declare-const y Int)
(declare-const a Int)
(declare-const b Int)
(assert (distinct x y))
(assert (not (= (store (store s x a) y b) (store (store s y b) x a))))
(check-sat-using (then (using-params simplify :som true) smt))
(get-proof)
