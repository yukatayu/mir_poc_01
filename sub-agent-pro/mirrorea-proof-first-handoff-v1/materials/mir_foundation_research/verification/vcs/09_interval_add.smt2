(set-option :timeout 10000)
(set-option :produce-proofs true)
(declare-const x Int)
(declare-const y Int)
(declare-const lx Int)
(declare-const ux Int)
(declare-const ly Int)
(declare-const uy Int)
(assert (<= lx x))
(assert (<= x ux))
(assert (<= ly y))
(assert (<= y uy))
(assert (not (and (<= (+ lx ly) (+ x y)) (<= (+ x y) (+ ux uy)))))
(check-sat-using (then (using-params simplify :som true) smt))
(get-proof)
