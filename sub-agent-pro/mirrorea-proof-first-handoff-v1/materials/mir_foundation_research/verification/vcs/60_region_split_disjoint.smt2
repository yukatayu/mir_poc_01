(set-option :timeout 10000)
(set-option :produce-proofs true)
(declare-const base Int)
(declare-const n Int)
(declare-const k Int)
(declare-const x Int)
(assert (> n 0))
(assert (> k 0))
(assert (< k n))
(assert (not (not (and (<= base x) (< x (+ base k)) (<= (+ base k) x) (< x (+ base n))))))
(check-sat-using (then (using-params simplify :som true) smt))
(get-proof)
