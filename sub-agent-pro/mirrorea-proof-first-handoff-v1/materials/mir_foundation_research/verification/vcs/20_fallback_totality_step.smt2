(set-option :timeout 10000)
(set-option :produce-proofs true)
(declare-const i Int)
(declare-const n Int)
(declare-const tail Int)
(declare-const valid Bool)
(assert (<= 0 i))
(assert (< i n))
(assert (<= (+ i 1) tail))
(assert (< tail n))
(assert (not (< (ite valid i tail) n)))
(check-sat-using (then (using-params simplify :som true) smt))
(get-proof)
