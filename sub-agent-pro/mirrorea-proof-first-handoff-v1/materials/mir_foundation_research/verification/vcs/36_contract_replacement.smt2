(set-option :timeout 10000)
(set-option :produce-proofs true)
(declare-const pOld Bool)
(declare-const pNew Bool)
(declare-const qOld Bool)
(declare-const qNew Bool)
(assert (=> pOld pNew))
(assert (=> qNew qOld))
(assert (=> pNew qNew))
(assert pOld)
(assert (not qOld))
(check-sat-using (then (using-params simplify :som true) smt))
(get-proof)
