(set-option :timeout 10000)
(set-option :produce-proofs true)
(declare-const old (Array Int Bool))
(declare-const current (Array Int Bool))
(declare-const x Int)
(assert (select current x))
(assert (not (or (select old x) (select current x))))
(check-sat-using (then (using-params simplify :som true) smt))
(get-proof)
