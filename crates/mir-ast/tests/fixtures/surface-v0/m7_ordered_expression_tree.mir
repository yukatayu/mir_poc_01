module Combat.M7.OrderedExpressionTree

locus S
principal self
type Player

state player[id: Player] at S {
  hp: Int
  atk: Int
}

Role[self] at S {
  when attack(target: Player) fails (StaleMembership, MissingCapability, MissingWitness, RouteUnavailable) {
    at S {
      player[self].hp = player[self].hp - player[self].atk + 1
    }
  }
}

designated evaluate E on tick F publish result = player[self].hp - 1 + player[self].atk
