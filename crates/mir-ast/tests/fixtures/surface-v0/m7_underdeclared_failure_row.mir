module Combat.M7.UnderdeclaredFailure

locus S
principal self
principal target
type Player

state player[id: Player] at S {
  hp: Int
  atk: Int
}

Role[self] at S {
  when attack(target: Player) fails (StaleMembership) {
    at S {
      player[target].hp = player[target].hp - player[self].atk
    }
  }
}
