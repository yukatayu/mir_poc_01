module Combat.M6.UnresolvedAmbiguous

locus S
locus Player
principal self
type Player

state player[id: Player] at S {
  hp: Int
  atk: Int
}

Role[self] at S {
  when attack(target: UnknownPlayer) fails (StaleMembership) {
    at S {
      player[target].hp = player[target].hp - missing[target].atk
    }
  }
}
