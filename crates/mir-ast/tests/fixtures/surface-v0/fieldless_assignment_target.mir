module Combat.M6

locus S
principal self
principal target
type Player

state player[id: Player] at S {
  hp: Int
  atk: Int
}

Role[self] at S {
  when attack(target: Player) fails (StaleMembership, MissingCapability, MissingWitness) {
    at S {
      player[target] = player[target].hp - 1
    }
  }
}
