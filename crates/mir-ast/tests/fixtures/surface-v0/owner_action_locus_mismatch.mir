module Combat.M6

locus S
locus T
principal self
principal target
type Player

state player[id: Player] at S {
  hp: Int
  atk: Int
}

Role[self] at S {
  when attack(target: Player) fails (StaleMembership, MissingCapability, MissingWitness) {
    at T {
      player[target].hp = player[target].hp - player[self].atk
    }
  }
}
