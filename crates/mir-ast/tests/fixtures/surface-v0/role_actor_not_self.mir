module Combat.M6

locus S
principal self
principal attacker
principal target
type Player

state player[id: Player] at S {
  hp: Int
  atk: Int
}

Role[attacker] at S {
  when attack(target: Player) fails (StaleMembership, MissingCapability, MissingWitness) {
    at S {
      player[target].hp = player[target].hp - player[target].atk
    }
  }
}
