module Combat.M7.RejectOversizeIntLiteral

locus S
principal self
type Player

state player[id: Player] at S {
  hp: Int
}

Role[self] at S {
  when attack(target: Player) fails (StaleMembership, MissingCapability, MissingWitness, RouteUnavailable) {
    at S {
      player[self].hp = 9223372036854775808
    }
  }
}
